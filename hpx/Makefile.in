.PRECIOUS: Makefile


@HPX_TRUE@check-local: hpx-bench$(EXEEXT) hpx-comm-check$(EXEEXT) hpx-message-check$(EXEEXT)
@HPX_TRUE@	./hpx-message-check$(EXEEXT)
@HPX_TRUE@	$(HPX_RUN) 3 2 "$(abs_builddir)/hpx-comm-check$(EXEEXT)"
@HPX_TRUE@	perl -w $(CHECK) $(CHECKOPTS) --mpi '$(HPX_RUN) 1 1 "$(abs_builddir)/hpx-bench$(EXEEXT)"'
@HPX_TRUE@	@echo "HPX FFTW transforms passed $(NUMCHECK) tests, 1 locality, 1 thread"
@HPX_TRUE@	perl -w $(CHECK) $(CHECKOPTS) --mpi '$(HPX_RUN) 2 1 "$(abs_builddir)/hpx-bench$(EXEEXT)"'
@HPX_TRUE@	@echo "HPX FFTW transforms passed $(NUMCHECK) tests, 2 localities, 1 thread each"
@HPX_TRUE@	perl -w $(CHECK) $(CHECKOPTS) --mpi '$(HPX_RUN) 3 1 "$(abs_builddir)/hpx-bench$(EXEEXT)"'
@HPX_TRUE@	@echo "HPX FFTW transforms passed $(NUMCHECK) tests, 3 localities, 1 thread each"
@HPX_TRUE@	perl -w $(CHECK) $(CHECKOPTS) --mpi '$(HPX_RUN) 4 1 "$(abs_builddir)/hpx-bench$(EXEEXT)"'
@HPX_TRUE@	@echo "HPX FFTW transforms passed $(NUMCHECK) tests, 4 localities, 1 thread each"
@HPX_TRUE@	perl -w $(CHECK) $(CHECKOPTS) --mpi --nthreads=2 '$(HPX_RUN) 3 2 "$(abs_builddir)/hpx-bench$(EXEEXT)"'
@HPX_TRUE@	@echo "HPX FFTW threaded transforms passed $(NUMCHECK) tests, 3 localities, 2 threads each"

@HPX_TRUE@bigcheck: hpx-bench$(EXEEXT)
@HPX_TRUE@	$(MAKE) $(AM_MAKEFLAGS) NUMCHECK=100 CHECKSIZE=60000 check-local

@HPX_TRUE@smallcheck: hpx-bench$(EXEEXT)
@HPX_TRUE@	$(MAKE) $(AM_MAKEFLAGS) NUMCHECK=2 check-local

