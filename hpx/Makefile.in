# fftw3-hpx.h includes the installed public header "fftw3.h".
AM_CPPFLAGS = -I $(top_srcdir) -I $(top_srcdir)/api
EXTRA_DIST = testsched.c hpx-run.sh README.md VALIDATION.md MPI_MAPPING.md .clang-format
@HPX_TRUE@lib_LTLIBRARIES = libfftw3@PREC_SUFFIX@_hpx.la
@HPX_TRUE@include_HEADERS = fftw3-hpx.h
@HPX_TRUE@AM_CXXFLAGS = $(HPX_CFLAGS)
@HPX_TRUE@TRANSPOSE_SRC = transpose-alltoall.c transpose-pairwise.c transpose-recurse.c transpose-problem.c transpose-solve.c hpx-transpose.h
@HPX_TRUE@DFT_SRC = dft-serial.c dft-rank-geq2.c dft-rank-geq2-transposed.c dft-rank1.c dft-rank1-bigvec.c dft-problem.c dft-solve.c hpx-dft.h
@HPX_TRUE@RDFT_SRC = rdft-serial.c rdft-rank-geq2.c rdft-rank-geq2-transposed.c rdft-rank1-bigvec.c rdft-problem.c rdft-solve.c hpx-rdft.h
@HPX_TRUE@RDFT2_SRC = rdft2-serial.c rdft2-rank-geq2.c rdft2-rank-geq2-transposed.c rdft2-problem.c rdft2-solve.c hpx-rdft2.h
@HPX_TRUE@SRC = any-true.c api.c block.c choose-radix.c conf.c dtensor.c fftw3-hpx.h ifftw-hpx.h rearrange.c wisdom-api.c hpx-comm.h hpx-comm.cpp
@HPX_TRUE@libfftw3@PREC_SUFFIX@_hpx_la_SOURCES = $(SRC) $(TRANSPOSE_SRC) $(DFT_SRC) $(RDFT_SRC) $(RDFT2_SRC)
@HPX_TRUE@libfftw3@PREC_SUFFIX@_hpx_la_LDFLAGS = -version-info @SHARED_VERSION_INFO@
@COMBINED_THREADS_FALSE@@HPX_TRUE@LIBFFTWTHREADS = $(top_builddir)/threads/libfftw3@PREC_SUFFIX@_threads.la
@HPX_TRUE@libfftw3@PREC_SUFFIX@_hpx_la_LIBADD = $(LIBFFTWTHREADS) ../libfftw3@PREC_SUFFIX@.la $(HPX_LIBS) $(THREADLIBS)
@HPX_TRUE@hpx_bench_CFLAGS = $(PTHREAD_CFLAGS)
@HPX_TRUE@hpx_bench_CXXFLAGS = $(HPX_APP_CFLAGS)
@HPX_TRUE@hpx_bench_SOURCES = hpx-bench.c hpx-bench-main.cpp $(top_srcdir)/tests/fftw-bench.c $(top_srcdir)/tests/hook.c
@HPX_TRUE@hpx_bench_LDADD = libfftw3@PREC_SUFFIX@_hpx.la $(LIBFFTWTHREADS) $(top_builddir)/libfftw3@PREC_SUFFIX@.la $(top_builddir)/libbench2/libbench2.a $(HPX_APP_LIBS) $(THREADLIBS)
@HPX_TRUE@hpx_comm_check_CXXFLAGS = $(HPX_APP_CFLAGS) -UNDEBUG
@HPX_TRUE@hpx_comm_check_SOURCES = hpx-comm-check.cpp
@HPX_TRUE@hpx_comm_check_LDADD = libfftw3@PREC_SUFFIX@_hpx.la $(LIBFFTWTHREADS) $(top_builddir)/libfftw3@PREC_SUFFIX@.la $(HPX_APP_LIBS) $(THREADLIBS)

# This ordinary-main test includes hpx-comm.cpp directly. Linking the HPX
# FFTW library here would duplicate its bridge symbols.
@HPX_TRUE@hpx_message_check_CXXFLAGS = $(HPX_CFLAGS) -UNDEBUG
@HPX_TRUE@hpx_message_check_SOURCES = hpx-message-check.cpp hpx-message-check.hpp
@HPX_TRUE@hpx_message_check_LDADD = $(HPX_LIBS) $(THREADLIBS)
@HPX_TRUE@CHECK = $(top_srcdir)/tests/check.pl
@HPX_TRUE@NUMCHECK = 10
@HPX_TRUE@CHECKSIZE = 10000
@HPX_TRUE@CHECKOPTS = --verbose --random --maxsize=$(CHECKSIZE) -c=$(NUMCHECK) $(CHECK_PL_OPTS)
@HPX_TRUE@HPX_RUN = $(SHELL) $(srcdir)/hpx-run.sh "$(HPXRUN)"
all: all-am

.SUFFIXES:
.SUFFIXES: .c .cpp .lo .o .obj
$(srcdir)/Makefile.in: @MAINTAINER_MODE_TRUE@ $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --gnu hpx/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --gnu hpx/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure: @MAINTAINER_MODE_TRUE@ $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4): @MAINTAINER_MODE_TRUE@ $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):

clean-noinstPROGRAMS:
	$(am__rm_f) $(noinst_PROGRAMS)
	test -z "$(EXEEXT)" || $(am__rm_f) $(noinst_PROGRAMS:$(EXEEXT)=)

install-libLTLIBRARIES: $(lib_LTLIBRARIES)
	@$(NORMAL_INSTALL)
	@list='$(lib_LTLIBRARIES)'; test -n "$(libdir)" || list=; \
	list2=; for p in $$list; do \
	  if test -f $$p; then \
	    list2="$$list2 $$p"; \
	  else :; fi; \
	done; \
	test -z "$$list2" || { \
	  echo " $(MKDIR_P) '$(DESTDIR)$(libdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(libdir)" || exit 1; \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 '$(DESTDIR)$(libdir)'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 "$(DESTDIR)$(libdir)"; \
	}

uninstall-libLTLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@list='$(lib_LTLIBRARIES)'; test -n "$(libdir)" || list=; \
	for p in $$list; do \
	  $(am__strip_dir) \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f '$(DESTDIR)$(libdir)/$$f'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f "$(DESTDIR)$(libdir)/$$f"; \
	done

clean-libLTLIBRARIES:
	-$(am__rm_f) $(lib_LTLIBRARIES)
	@list='$(lib_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	echo rm -f $${locs}; \
	$(am__rm_f) $${locs}

libfftw3@PREC_SUFFIX@_hpx.la: $(libfftw3@PREC_SUFFIX@_hpx_la_OBJECTS) $(libfftw3@PREC_SUFFIX@_hpx_la_DEPENDENCIES) $(EXTRA_libfftw3@PREC_SUFFIX@_hpx_la_DEPENDENCIES)
	$(AM_V_CXXLD)$(libfftw3@PREC_SUFFIX@_hpx_la_LINK) $(am_libfftw3@PREC_SUFFIX@_hpx_la_rpath) $(libfftw3@PREC_SUFFIX@_hpx_la_OBJECTS) $(libfftw3@PREC_SUFFIX@_hpx_la_LIBADD) $(LIBS)

hpx-bench$(EXEEXT): $(hpx_bench_OBJECTS) $(hpx_bench_DEPENDENCIES) $(EXTRA_hpx_bench_DEPENDENCIES)
	@rm -f hpx-bench$(EXEEXT)
	$(AM_V_CXXLD)$(hpx_bench_LINK) $(hpx_bench_OBJECTS) $(hpx_bench_LDADD) $(LIBS)

hpx-comm-check$(EXEEXT): $(hpx_comm_check_OBJECTS) $(hpx_comm_check_DEPENDENCIES) $(EXTRA_hpx_comm_check_DEPENDENCIES)
	@rm -f hpx-comm-check$(EXEEXT)
	$(AM_V_CXXLD)$(hpx_comm_check_LINK) $(hpx_comm_check_OBJECTS) $(hpx_comm_check_LDADD) $(LIBS)

hpx-message-check$(EXEEXT): $(hpx_message_check_OBJECTS) $(hpx_message_check_DEPENDENCIES) $(EXTRA_hpx_message_check_DEPENDENCIES)
	@rm -f hpx-message-check$(EXEEXT)
	$(AM_V_CXXLD)$(hpx_message_check_LINK) $(hpx_message_check_OBJECTS) $(hpx_message_check_LDADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

