 #include "config.h"
 #include "hpx-comm.h"
+#include "receive-diagnostics.hpp"
+
+// This entire source is a temporary diagnostic variant. Its relaxed atomic
+// counters are absent from hpx-comm.cpp and must not be used for final timing.
+namespace FFTW_HPX_COMM_FN(receive_diagnostics)
+{
+enum class Metric : size_t
+{
+    posted,
+    disabled_registration,
+    remote_load,
+    direct_hit,
+    fallback_unposted,
+    pool_hit,
+    pool_miss,
+    unpooled_allocation,
+    self_copy,
+    final_copy,
+    direct_copy_elided,
+    count
+};
+
+struct Counter
+{
+    std::atomic<std::uint64_t> calls{0};
+    std::atomic<std::uint64_t> bytes{0};
+};
+
+std::array<Counter, static_cast<size_t>(Metric::count)> counters;
+
+void record(Metric const metric, size_t const bytes)
+{
+    auto & counter = counters[static_cast<size_t>(metric)];
+    counter.calls.fetch_add(1, std::memory_order_relaxed);
+    counter.bytes.fetch_add(bytes, std::memory_order_relaxed);
+}
+
+void reset()
+{
+    for (auto & counter : counters)
+    {
+        counter.calls.store(0, std::memory_order_relaxed);
+        counter.bytes.store(0, std::memory_order_relaxed);
+    }
+}
+
+void report(int const rank, int const sample)
+{
+    static constexpr std::array<char const *, static_cast<size_t>(Metric::count)>
+        names{{"posted", "disabled_registration", "remote_load", "direct_hit",
+               "fallback_unposted", "pool_hit", "pool_miss",
+               "unpooled_allocation", "self_copy", "final_copy",
+               "direct_copy_elided"}};
+    for (size_t index = 0; index < counters.size(); ++index)
+    {
+        auto const calls = counters[index].calls.load(std::memory_order_relaxed);
+        auto const bytes = counters[index].bytes.load(std::memory_order_relaxed);
+        std::fprintf(stderr,
+                     "RECEIVE_DIAGNOSTIC rank=%d sample=%d metric=%s "
+                     "calls=%llu bytes=%llu\n",
+                     rank, sample, names[index],
+                     static_cast<unsigned long long>(calls),
+                     static_cast<unsigned long long>(bytes));
+    }
+}
+} // namespace FFTW_HPX_COMM_FN(receive_diagnostics)
+
+extern "C" void FFTW_HPX_COMM_FN(receive_diagnostics_reset)(void)
+{
+    FFTW_HPX_COMM_FN(receive_diagnostics)::reset();
+}
+
+extern "C" void FFTW_HPX_COMM_FN(receive_diagnostics_report)(int const rank,
+                                                           int const sample)
+{
+    FFTW_HPX_COMM_FN(receive_diagnostics)::report(rank, sample);
+}
 
